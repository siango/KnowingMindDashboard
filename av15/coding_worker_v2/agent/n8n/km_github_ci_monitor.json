{"active": false, "name": "KM GitHub CI Monitor", "nodes": [{"id": "sched-ci", "name": "Every 10m", "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 10}]}}, "position": [240, 300], "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2}, {"id": "http-runs", "name": "List Runs", "parameters": {"sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{ $env.GH_TOKEN }}"}, {"name": "Accept", "value": "application/vnd.github+json"}]}, "url": "=https://api.github.com/repos/{{ $env.GH_REPO }}/actions/runs?per_page=5"}, "position": [460, 300], "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2}, {"id": "code-failed", "name": "Failed Runs", "parameters": {"jsCode": "const runs = ($input.first().json.workflow_runs || []).filter(r => r.conclusion && r.conclusion !== 'success');\nreturn runs.map(r => ({ json: { id: r.id, name: r.name, branch: r.head_branch, conclusion: r.conclusion, url: r.html_url } }));"}, "position": [680, 300], "type": "n8n-nodes-base.code", "typeVersion": 2}, {"id": "http-cialert", "name": "CI Alert", "parameters": {"method": "POST", "sendBody": true, "specifyBody": "json", "url": "={{ $env.KM_ALERT_URL }}"}, "position": [900, 300], "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2}], "connections": {"Every 10m": {"main": [[{"index": 0, "node": "List Runs", "type": "main"}]]}, "List Runs": {"main": [[{"index": 0, "node": "Failed Runs", "type": "main"}]]}, "Failed Runs": {"main": [[{"index": 0, "node": "CI Alert", "type": "main"}]]}}}
