#!/usr/bin/env bash
# km — KM Intelligent Coding Agent V3 entry. Non-interactive subcommands.
set -u
BASE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONUTF8=1
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
PY="$BASE/.venv/bin/python"
[ -x "$PY" ] || PY="python3"
if [ -f "$BASE/coding_worker_v2/.env" ]; then
  set -a; . "$BASE/coding_worker_v2/.env"; set +a
fi
if [ -n "${KMW2_SOURCE_ROOT:-}" ]; then
  if [[ ! "${KMW2_SOURCE_SHA:-}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "KMCW_SOURCE_PIN_REQUIRED: set KMW2_SOURCE_SHA to the approved commit" >&2
    exit 1
  fi
  SOURCE="$(cd -- "$KMW2_SOURCE_ROOT" && pwd -P)" || exit 1
  SHA="$(git -C "$SOURCE" rev-parse HEAD)" || exit 1
  if [ "$SHA" != "$KMW2_SOURCE_SHA" ] ||
     [ ! -f "$SOURCE/coding_worker_v2/agent/km_main.py" ]; then
    echo "KMCW_SOURCE_MISMATCH: configured source does not match the approved commit" >&2
    exit 1
  fi
  DIRTY="$(git -C "$SOURCE" status --porcelain --untracked-files=normal -- coding_worker_v2 km)" || exit 1
  if [ -n "$DIRTY" ]; then
    echo "KMCW_SOURCE_DIRTY: refusing uncommitted worker code" >&2
    exit 1
  fi
  export KMW2_STATE_DIR="${KMW2_STATE_DIR:-$BASE/state}"
  echo "KMCW source_sha=$SHA source_root=$SOURCE runtime_base=$BASE/coding_worker_v2" >&2
  cd "$BASE" && exec "$PY" "$SOURCE/coding_worker_v2/agent/km_main.py" \
    --base "$BASE/coding_worker_v2" --workspace "$BASE" "$@"
fi
cd "$BASE" && exec "$PY" -m coding_worker_v2.agent.km_main "$@"
